# Environment: "development" or "production". In production, JWT_SECRET and
# AES_KEY are mandatory — the server refuses to boot without them.
NODE_ENV=development

# HTTP port the Fastify server listens on.
PORT=3333

# PostgreSQL connection string for the main (dev) database.
DATABASE_URL=postgres://beholder:beholder@localhost:5432/beholder

# PostgreSQL connection string for the Vitest integration test database.
# Must be a SEPARATE database from DATABASE_URL — tests truncate all tables.
TEST_DATABASE_URL=postgres://beholder:beholder@localhost:5432/beholder_test

# 48 random bytes, hex-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Must decode to exactly 32 bytes via utf8. Generate a 32-hex-character
# string (16 random bytes hex-encoded) with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
AES_KEY=

# Single-operator seed credentials, upserted on every server boot.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Comma-separated list of allowed CORS origins, e.g.:
#   CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
