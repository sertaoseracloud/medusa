# Environment: "development" or "production". In production, JWT_SECRET and
# AES_KEY are mandatory — the server refuses to boot without them.
NODE_ENV=development

# HTTP port the Fastify server listens on.
PORT=3333

# PostgreSQL connection string for the main (dev) database.
DATABASE_URL=postgres://beholder:beholder@localhost:5432/beholder

# PostgreSQL connection string for the Vitest integration test database.
# Must be a SEPARATE database from DATABASE_URL — tests truncate all tables.
TEST_DATABASE_URL=postgres://beholder:beholder@localhost:5432/beholder_test

# 48 random bytes, hex-encoded. Must be at least 32 characters in
# production (enforced at boot). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Must decode (base64) to exactly 32 RAW random bytes — used verbatim as
# an AES-256-GCM key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NOTE: do NOT hex-encode 16 random bytes into a 32-character string — that
# recipe passes the length check but only carries ~128 bits of real entropy
# (each hex char is one of 16 ASCII values), silently halving the intended
# AES-256 key strength.
AES_KEY=

# Single-operator seed credentials, upserted on every server boot.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Comma-separated list of allowed CORS origins, e.g.:
#   CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
